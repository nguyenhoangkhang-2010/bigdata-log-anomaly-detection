# Sao chép thành .env để đổi cổng/cấu hình cho `docker compose` (không bắt buộc, đều có giá trị mặc định).

# --- Ứng dụng (luôn chạy) ---
WEB_PORT=3000                 # giao diện: http://localhost:3000
API_PORT=8000                 # API + Swagger: http://localhost:8000/docs  (đổi nếu uvicorn chạy tay đang giữ cổng 8000)
LOGAD_DATA_SOURCE=auto        # auto = Elasticsearch có dữ liệu > tệp kết quả > dữ liệu mô phỏng | demo | files | elasticsearch

# --- Big Data (profile bigdata: HDFS + Spark; profile search: Elasticsearch + Kibana) ---
HDFS_UI_PORT=9870
HDFS_RPC_PORT=9000
SPARK_UI_PORT=8080
SPARK_WORKER_CORES=8          # máy 20 lõi / Docker 20 GB RAM; giảm nếu máy yếu hơn
SPARK_WORKER_MEMORY=8g
ES_PORT=9200
KIBANA_PORT=5601
