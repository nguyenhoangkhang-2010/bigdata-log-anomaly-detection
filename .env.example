# Ứng dụng (docker compose mặc định)
WEB_PORT=3000                 # giao diện: http://localhost:3000
API_PORT=8000                 # API + Swagger: http://localhost:8000/docs  (đổi nếu uvicorn local đang giữ cổng 8000)
LOGAD_DATA_SOURCE=demo        # demo | elasticsearch (elasticsearch chưa cài đặt)

# Big Data (profile bigdata / search)
HDFS_UI_PORT=9870
HDFS_RPC_PORT=9000
SPARK_UI_PORT=8080
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=3g
ES_PORT=9200
KIBANA_PORT=5601
